# Dex2oat & ART compilation
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.dex2oat-threads=6
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.boot-dex2oat-threads=8
dalvik.vm.bg-dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.bg-dex2oat-threads=6
dalvik.vm.usejit=true
dalvik.vm.usejitprofiles=true
pm.dexopt.shared=speed
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.ab-ota=speed-profile

# Audio frame & AAudio MMAP tuning
audio.deep_buffer.media=true
audio.offload.video=true
audio.offload.min.duration.secs=30
audio.offload.gapless.enabled=true
aaudio.mmap_policy=2
aaudio.mmap_exclusive_policy=2
aaudio.hw_burst_min_usec=2000
ro.audio.monitorRotation=true
ro.config.media_vol_default=10
ro.config.media_vol_steps=25
ro.config.vc_call_vol_steps=11

# Telephony framework config
persist.radio.multisim.config=dsds
ro.telephony.default_network=33,33
ro.telephony.sim.count=2
telephony.active_modems.max_count=2

# Dalvik/ART Heap
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=8m
dalvik.vm.heapmaxfree=32m

# Hardware Rendering
ro.hwui.use_vulkan=false
debug.sf.auto_latch_unsignaled=false

# SurfaceFlinger (120Hz Display Tweaks)
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.use_color_management=true
ro.surface_flinger.enable_layer_caching=true
ro.surface_flinger.use_context_priority=true
debug.sf.early.app.duration=10500000
debug.sf.earlyGl.app.duration=10500000
debug.sf.late.app.duration=10500000
debug.sf.early.sf.duration=8333333
debug.sf.late.sf.duration=8333333

# Touch Responsiveness & Fling
ro.min.fling_velocity=160
ro.max.fling_velocity=12000

# Power & Misc Optimization
ro.vendor.mtk_power_ext_ctrl=1
